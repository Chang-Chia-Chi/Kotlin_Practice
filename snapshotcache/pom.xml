<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dynacache</groupId>
        <artifactId>dynacache-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>snapshotcache</artifactId>
    <name>DuckDB Generational Snapshot Cache</name>

    <properties>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <archunit.version>1.3.0</archunit.version>
        <jdbi.version>3.45.4</jdbi.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <ojdbc.version>23.5.0.24.07</ojdbc.version>
        <minio.version>8.5.17</minio.version>
        <!-- The Testcontainers MinIO module is newer than the core the Oracle tests pin; its
             own core is excluded below so both container types run on 1.20.4. -->
        <testcontainers.minio.version>1.21.3</testcontainers.minio.version>
        <!-- Already on the classpath transitively via MinIO; declared so the inventory CLOB's
             codec does not silently depend on a transitive that MinIO could drop. -->
        <jackson.version>2.18.0</jackson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <!-- D27: the only logging API in api/spi/core; what Quarkus itself is built on. -->
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <version>3.6.1.Final</version>
        </dependency>
        <!-- Pinned to 1.1.3 by spec 14.5 (CI Linux component constraint). Do not upgrade. -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>1.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- M3/P11: the archive layer's manifest DAO. Confined to infra.snapshotarchive by
             the ArchUnit rules in ArchitectureTest - plan 2.4 forbids JDBI in api, spi and
             core, and this package is caller-land, not framework. -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
            <version>${jdbi.version}</version>
        </dependency>
        <!-- P11 acceptance is Oracle sequence allocation, conditional-UPDATE row counts and
             CLOB round-tripping. None of those are provable against a stand-in, so the DAO
             contract tests run on a real Oracle, as SimpleEtl's read seam already does. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>oracle-free</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${ojdbc.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- M3/P12: the archive layer's object store, behind the concrete ObjectStore wrapper.
             Same fence as JDBI above - the ArchUnit rules keep it inside infra.snapshotarchive,
             so the framework core still boots with neither MinIO nor a network. -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>
        <!-- The inventory CLOB codec (spec 18.2). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- P12's protocol tests drive a fake object store so the crash matrix stays fast and
             deterministic. This container exists for the one thing a fake cannot prove: that
             ObjectStore's put/stat really do what the fake pretends. Its transitive
             Testcontainers core is excluded so the Oracle tests' 1.20.4 core serves both. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <version>${testcontainers.minio.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
