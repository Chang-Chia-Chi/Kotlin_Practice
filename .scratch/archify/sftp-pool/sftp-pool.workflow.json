    {
      "dot": "cyan",
      "title": "The three invariants",
      "items": [
        "One caller per session, ever",
        "Never more sessions than maxSize",
        "Nothing untrustworthy is handed on"
      ]
    },
    {
      "dot": "violet",
      "title": "The lock never dials",
      "items": [
        "The registry decides; it cannot dial",
        "Three claim states make that safe",
        "Housekeeping ages out and tops up"
      ]
    },
