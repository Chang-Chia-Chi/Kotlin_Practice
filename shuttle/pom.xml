<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dynacache</groupId>
        <artifactId>dynacache-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>shuttle</artifactId>
    <name>Shuttle</name>

    <!-- G0. One module; packages are the boundary and ArchitectureTest enforces them.
         `infra.shuttle.core` is framework-free; every technology is an adapter package. -->

    <properties>
        <!-- 17, like the connector this module will depend on (its spec: the host runs JDK 17). -->
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
        <maven.compiler.release>17</maven.compiler.release>
        <quarkus.version>3.17.5</quarkus.version>
        <!-- Container-backed tiers are opt-in: `-DexcludedGroups=none`. A property, not a literal,
             for the reason etl-host/pom.xml gives: a literal in <configuration> beats the user
             property and the documented opt-in would silently run zero tests. -->
        <excludedGroups>oracle,minio,nats,acceptance,load</excludedGroups>
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BEFORE the BOM import; the order is load-bearing, exactly as etl-host/pom.xml
                 explains: a child's entries win in declaration order, so stating kotlin-stdlib
                 and micrometer first keeps them on the reactor's versions instead of the ones the
                 platform ships. The BOM is imported now so every later ticket's Quarkus, Jackson,
                 Mockito and JDBI versions resolve from one place; no Quarkus dependency yet. -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-core</artifactId>
                <version>${coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-test</artifactId>
                <version>${coroutines.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- G13. The reactor parent manages micrometer-core itself (1.17.1), and a parent's explicit entry
                 beats a child's BOM import, so without this line the module ran a 1.17 core beside the
                 1.14 commons the BOM below manages: fine until Quarkus binds its registry and calls a
                 commons method the older jar lacks (NoSuchMethodError: WarnThenDebugLogger.isEnabled).
                 Stated explicitly here, the whole of Micrometer is 1.14.2. -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>1.14.2</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-bom</artifactId>
                <version>1.14.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- G12. The connector test kit's embedded SSHD brings sshd-core 2.19.0 with it, and
                 the platform BOM below would otherwise hold sshd-common back to 2.12.1: the two
                 halves of one server on two versions. Stated first, so both are 2.19.0. -->
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-common</artifactId>
                <version>2.19.0</version>
                <scope>test</scope>
            </dependency>
            <!-- G10. Stated before the platform BOM so the S3 client and its HTTP client are one
                 SDK version; 2.29.51 is what the local repository holds. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.29.51</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The whole compile classpath of `core`; ArchitectureTest holds the list to this. -->
        <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId></dependency>
        <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core</artifactId></dependency>
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-core</artifactId></dependency>
        <dependency><groupId>org.jboss.logging</groupId><artifactId>jboss-logging</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <!-- G1: the `yaml` package only; ArchitectureTest keeps it out of `core`. -->
        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
        <!-- G10: the `s3` package only. Synchronous client over the Apache HTTP client (D4); the
             SDK's Netty client is excluded because nothing here is asynchronous. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId><artifactId>s3</artifactId>
            <exclusions>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></dependency>
        <!-- httpclient 4.x logs through commons-logging and the quarkus BOM leaves it off the runtime
             classpath (Quarkus supplies its own bridge); without this the first S3 call dies with
             NoClassDefFoundError: LogFactory. Ticket 14 may swap it for the Quarkus bridge. -->
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><version>1.2</version><scope>runtime</scope></dependency>

        <!-- G15: the `nats` package only. 2.21.2 is what the local repository holds. -->
        <dependency><groupId>io.nats</groupId><artifactId>jnats</artifactId><version>2.21.2</version></dependency>

        <!-- G12: the `sftp` package only; ArchitectureTest keeps `sftp.connector..` out of every
             other package. The test kit is the connector's own embedded SSHD, used by the sftp
             package's tests and nothing else. -->
        <dependency><groupId>dynacache</groupId><artifactId>sftpconnector-core</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
        <dependency><groupId>dynacache</groupId><artifactId>sftpconnector-testkit</artifactId><version>0.1.0-SNAPSHOT</version><scope>test</scope></dependency>

        <!-- G9: the `jdbi` package only. The Oracle driver is the host's runtime concern
             (ticket 14); here it is test-scoped for the Testcontainers class. -->
        <dependency><groupId>org.jdbi</groupId><artifactId>jdbi3-core</artifactId><version>3.45.4</version></dependency>

        <!-- G13: the `quarkus` package only. The same extension set etl-host runs on, minus the
             scheduler: CDI, REST with Jackson, the role check and its smallest real identity
             provider, health at /q/health/ready, a Prometheus registry so the meters are real, and
             the datasource the Oracle state store reads (ojdbc11 rides in at runtime scope with it). -->
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-jackson</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-security</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-elytron-security-properties-file</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-smallrye-health</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-micrometer-registry-prometheus</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-agroal</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-jdbc-oracle</artifactId></dependency>

        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit5</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-test-security</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
        <!-- G13: a real JDBC database with no tables, for the boot check that names the DDL. -->
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>oracle-free</artifactId>
            <version>${testcontainers.version}</version><scope>test</scope>
        </dependency>
        <!-- The MinIO tier, tagged `minio`. The MinIO module is newer than the Testcontainers core
             the Oracle module (ticket 10) pins, so its own core is excluded and 1.20.4 serves both,
             the arrangement etl-host/pom.xml uses for the same reason. -->
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId>
            <version>1.20.4</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>minio</artifactId>
            <version>1.21.3</version><scope>test</scope>
            <exclusions>
                <exclusion><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId></exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <!-- Kotlin classes are final and CDI subclasses what it proxies or intercepts;
                         all-open on the three annotations the host uses, as etl-host does. -->
                    <compilerPlugins><plugin>all-open</plugin></compilerPlugins>
                    <pluginOptions>
                        <option>all-open:annotation=jakarta.enterprise.context.ApplicationScoped</option>
                        <option>all-open:annotation=jakarta.inject.Singleton</option>
                        <option>all-open:annotation=jakarta.ws.rs.Path</option>
                    </pluginOptions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution><id>compile</id><phase>compile</phase><goals><goal>compile</goal></goals></execution>
                    <execution><id>test-compile</id><phase>test-compile</phase><goals><goal>test-compile</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <trimStackTrace>false</trimStackTrace>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
