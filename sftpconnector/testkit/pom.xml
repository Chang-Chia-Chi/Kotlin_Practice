<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dynacache</groupId>
        <artifactId>sftpconnector</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sftpconnector-testkit</artifactId>
    <name>SFTP Connector (testkit)</name>

    <properties>
        <!-- The opt-in tiers. The soak runs for as long as it is told, and the measurements are
             observations for the progress log rather than assertions; neither belongs in every
             build. -Dsftp.soak.minutes=N runs the soak alone, -Dsftp.measure runs the measurements alone. -->
        <sftp.excludedGroups>soak,measure</sftp.excludedGroups>
        <sftp.groups></sftp.groups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dynacache</groupId>
            <artifactId>sftpconnector-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- A real SSH and SFTP server, so the JSch adapter is proven against a server rather
             than against a stand-in that agrees with whatever the adapter does. -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <!-- Virtual time. A pool test that waits on an acquire timeout must not wait for it. -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
        </dependency>
        <!-- The partition tier: a Toxiproxy container between the CONNECT proxy and the server,
             for the faults a loopback tunnel cannot stage. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-toxiproxy</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${sftp.groups}</groups>
                    <excludedGroups>${sftp.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>soak</id>
            <activation>
                <property>
                    <name>sftp.soak.minutes</name>
                </property>
            </activation>
            <properties>
                <sftp.groups>soak</sftp.groups>
                <sftp.excludedGroups>measure</sftp.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>measure</id>
            <activation>
                <property>
                    <name>sftp.measure</name>
                </property>
            </activation>
            <properties>
                <sftp.groups>measure</sftp.groups>
                <sftp.excludedGroups>soak</sftp.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
