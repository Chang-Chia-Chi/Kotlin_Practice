<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dynacache</groupId>
        <artifactId>sftpconnector</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sftpconnector-quarkus</artifactId>
    <name>SFTP Connector (Quarkus adapter)</name>

    <properties>
        <!-- The one Quarkus in this repository, and the reason is availability rather than
             taste: `etl-host` picked 3.17.5 because it is the newest version whose every
             extension is already in the local repository, and a second version here would
             mean a second set of downloads for no gain. -->
        <quarkus.version>3.17.5</quarkus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BEFORE the platform BOM, and the order is load-bearing. A module's own
                 dependencyManagement is resolved in declaration order and beats what it
                 inherits, so an unqualified quarkus-bom import would pull kotlin-stdlib back
                 to the Kotlin the platform ships while kotlin-maven-plugin compiles with the
                 reactor's. Same-version compiler and stdlib, stated first. -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <!-- Held to the platform's Micrometer rather than the reactor's, and stated
                 explicitly because the reactor's entry would otherwise win: the platform BOM
                 manages the registry implementation and micrometer-commons but not
                 micrometer-core, so without this line the module resolves a 1.17 core beside a
                 1.13 commons - the split-version mixture that actually breaks. The connector
                 only ever touches MeterRegistry, Counter, Gauge and Timer, which have been
                 what they are since Micrometer 1.0, so it is the older of the two that is
                 safe to converge on. -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>1.13.7</version>
            </dependency>
            <!-- Also ahead of the platform BOM, and for the mirror image of the reason above:
                 the platform manages sshd-common but not sshd-core, so the embedded server the
                 tests boot would run a 2.19 core against a 2.12 common and fail at the first
                 call to a method the older one does not have. The whole of SSHD moves together
                 or none of it does. -->
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-common</artifactId>
                <version>2.19.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId></dependency>
        <dependency>
            <groupId>dynacache</groupId>
            <artifactId>sftpconnector-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core</artifactId></dependency>

        <!-- CDI, and with it SmallRye Config's @ConfigMapping. -->
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc</artifactId></dependency>
        <!-- The MeterRegistry the connector is handed, and no more than that. Which registry
             stands behind it is the host's to choose, so no registry implementation ships from
             here: a library that brought one would put Prometheus on the classpath of every
             host that wanted an SFTP connector. -->
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-micrometer</artifactId></dependency>

        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit5</artifactId><scope>test</scope></dependency>
        <!-- The choice this module's own test makes for itself, and the reason it is a choice:
             quarkus-micrometer alone binds a composite registry with no children, on which every
             gauge the pool registers is a silent no-op - so a test on that registry would go
             green against nothing. A registry implementation is what makes the series real, and
             what a scrape returns is where the "gauges appear in the host's metrics endpoint"
             checkbox actually lives. -->
        <dependency>
            <groupId>io.quarkus</groupId><artifactId>quarkus-micrometer-registry-prometheus</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The embedded server the adapter is booted against. Test-scoped: nothing a
             deployment runs needs it, and it would otherwise ride into every host. -->
        <dependency>
            <groupId>dynacache</groupId>
            <artifactId>sftpconnector-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <!-- `generate-code` and its test twin, and deliberately not `build`: this module
                     is a library a host depends on, not an application, so there is no runner to
                     package. What the plugin is here for is the application model the @QuarkusTest
                     boots against. -->
                <executions>
                    <execution>
                        <goals>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
