<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dynacache</groupId>
        <artifactId>dynacache-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>SimpleEtl</artifactId>
    <name>YAML-Driven ETL Framework</name>

    <properties>
        <!-- A property, not a <configuration> literal: a literal beats the user property of the same
             name, so the documented opt-in would silently run zero tests and report SUCCESS - measured
             by the P9 round, 2026-08-30. Opt in with -DexcludedGroups=none. -->
        <excludedGroups>spike,oracle</excludedGroups>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
        <testcontainers.version>1.20.4</testcontainers.version>
        <ojdbc.version>23.5.0.24.07</ojdbc.version>
        <mockito.version>5.14.2</mockito.version>
        <archunit.version>1.3.0</archunit.version>
        <jdbi.version>3.45.4</jdbi.version>
        <jackson.version>2.18.2</jackson.version>
    </properties>

    <!-- testcontainers pulls byte-buddy 1.14.18, mockito 5.14.2 wants 1.15.4. On Java 22 the
         skew fails mock creation at runtime, not at resolve time. Pin the newer one. -->

    <!-- Spikes (`@Tag("spike")`) and the Testcontainers Oracle classes (`@Tag("oracle")`) are
         excluded from the default run. This replaces the old naming-convention trick (spikes
         named `*Spike` to dodge surefire's default include pattern) which any `-Dtest=` silently
         defeated - one spike appends 6.2M rows ten times. `-Dgroups=oracle` or `-Dgroups=spike`
         opts back in deliberately. -->
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- -XX:+EnableDynamicAgentLoading exists only from JDK 21 - target=17 above is a real
         consumer-compatibility promise, so a developer on the advertised JDK 17 must not get
         "Unrecognized VM option" at test startup. Confined to a profile keyed on the running
         JDK rather than the compiler target. -->
    <profiles>
        <profile>
            <id>dynamic-agent-loading</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Mockito 5 self-attaches its inline mock maker; Java 22 warns, and a
                                 future JDK will refuse. ponytail: flag now, -javaagent when it breaks. -->
                            <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>1.15.4</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>1.15.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <!-- Pinned to 1.1.3 by spec 1.4 (CI glibc constraint). Do not upgrade. -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>1.1.3</version>
        </dependency>
        <!-- P6: spec 10 loads task files by scanning a directory and deserialising with
             Jackson YAML. Bean Validation is deliberately absent - the 17 rules of spec 10
             are custom logic, and a validation framework for them is more code, not less. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- P2: spec 11.1 declares JdbcTableWriter(jdbi) and JdbcStatementWriter(jdbi). -->
        <!-- P9: spec 7.3's cache read step calls the cache's own copyOut, so no row passes
             through the JVM. One-way: snapshotcache has no dependency back, and the reactor
             already builds it first. Only infra.etl.task may import it - see ArchitectureTest. -->
        <dependency>
            <groupId>dynacache</groupId>
            <artifactId>snapshotcache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- P7: limitedParallelism(1) per task (spec 8.3). Version managed by the parent.
             Quarkus is deliberately absent: spec 8.6 makes the cron binding and the HTTP
             resource host obligations, so this module boots no framework to test itself. -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
            <version>${jdbi.version}</version>
        </dependency>
        <!-- P8a: spec 9.2's listener isolation and 9.4's swallowed onFailure both log. CLAUDE.md
             fixes the API as org.jboss.logging.Logger, not io.quarkus.logging.Log: Quarkus is
             built on JBoss Logging so quarkus.log.* config applies unchanged, and naming the
             Quarkus type would drag a framework into a module that deliberately boots none
             (spec 8.6). On the classpath today only through an undeclared transitive edge from
             snapshotcache; declared here so it survives that edge moving. -->
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <version>3.6.1.Final</version>
        </dependency>
        <!-- P8b: spec 9.3's six meters, bound in infra.etl.micrometer and named nowhere else.
             `optional`, and that is load-bearing: spec 2.1's whole reason for existing is that
             Layer 1 ships to the snapshot cache without Layer 2, and Maven has no layer
             granularity - inherited transitively, every Layer 1 consumer would get Micrometer.
             `optional` keeps compile scope (so SimpleMeterRegistry is on this module's own
             compile and test classpath for the label contract test) while consumers resolve
             nothing transitively. This replaced `provided`, which achieved the same
             non-transitivity - measured on a throwaway two-module reactor at P8b, a consumer
             resolved zero micrometer artefacts - but claimed a container supplies the jar at
             runtime, and nothing does. Same effect, honest semantics. A host wiring
             MicrometerTaskMetrics necessarily already has a MeterRegistry. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <version>1.14.2</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <!-- The package split of infra.etl is a dependency contract, not a filing scheme.
             These rules are what keep it true; see ArchitectureTest. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- P1: spec 4.3 is about Oracle's own type quirks, so the read seam is tested
             against a real Oracle, not a stand-in. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>oracle-free</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${ojdbc.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
